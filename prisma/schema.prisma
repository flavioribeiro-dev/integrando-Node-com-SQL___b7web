generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model User {
    id        Int      @id @default(autoincrement())
    nome      String
    sobrenome String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    posts     Post[]
}

model Post {
    id        Int      @id @default(autoincrement())
    titulo    String
    Subtitulo String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    usuarioId Int
    usuario   User     @relation(fields: [usuarioId], references: [id])
}
