generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

enum Funcao {
    ADMIN
    USER
}

model User {
    id        Int      @id @default(autoincrement())
    nome      String
    sobrenome String?
    funcao    Funcao   @default(USER)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    posts     Post[]

    @@map("users")
}

model Post {
    id        Int      @id @default(autoincrement())
    titulo    String
    Subtitulo String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    usuarioId Int
    usuario   User     @relation(fields: [usuarioId], references: [id])

    @@map("posts")
}
